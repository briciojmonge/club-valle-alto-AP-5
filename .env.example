# Copie este archivo a .env (o defina las variables en el panel del hosting).
SECRET_KEY=cambie-esto-por-un-valor-largo-y-aleatorio
# Ruta de la base de datos SQLite (por defecto instance/club.db)
DATABASE=instance/club.db
# Correo saliente (opcional). Sin MAIL_SERVER las notificaciones se guardan
# en el historial con estado "simulado" y no se envían.
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_USE_TLS=true
MAIL_FROM=Club Valle Alto <no-responder@example.com>
# URL pública de la plataforma (se usa en los enlaces de los correos)
BASE_URL=http://127.0.0.1:5000
