# Copie este archivo a .env (o defina las variables en el panel del hosting).
SECRET_KEY=cambie-esto-por-un-valor-largo-y-aleatorio
# Ruta de la base de datos SQLite (por defecto instance/club.db)
DATABASE=instance/club.db
# Correo saliente: smtp o resend. Elija un solo proveedor.
# Con smtp y MAIL_SERVER vacío, los correos quedan como "simulado".
MAIL_PROVIDER=smtp
# Gmail para local
MAIL_SERVER=
MAIL_PORT=587
MAIL_AUTH_METHOD=login
MAIL_USERNAME=club.valle.alto@example.com
MAIL_PASSWORD="Contraseña"
MAIL_USE_TLS=true
MAIL_FROM="Club Valle Alto <club.valle.alto@example.com>"
# OCI SMTPS: sustituya las variables SMTP anteriores si utiliza OCI.
# MAIL_SERVER=servidor-smtp-de-tu-region
# MAIL_PORT=465
# MAIL_USE_SSL=true
# MAIL_USE_TLS=false
# MAIL_AUTH_METHOD=auto
# MAIL_USERNAME=usuario-smtp-de-oci
# MAIL_PASSWORD="contraseña-smtp-de-oci"
# MAIL_FROM="Club Valle Alto <clubvallealto@tu-dominio.com>"

# PythonAnywhere y Resend: seleccione MAIL_PROVIDER=resend y configure:
# RESEND_API_KEY=clave_de_api
# MAIL_FROM="Club Valle Alto <avisos@tu-dominio_verificado.com>"

# URL pública de la plataforma (se usa en los enlaces de los correos)
BASE_URL=http://127.0.0.1:5000
